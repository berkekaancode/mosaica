generator client {
  provider = "prisma-client"
  output = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  libraryEntries LibraryEntry[]
  collections Collection[]
  tags Tag[]
  @@map("users")
}

model Content {
  id String @id @default(uuid())
  title String
  mediaType String
  originalTitle String?
  releaseYear Int?
  runtimeMinutes Int?
  originalLanguage String?
  country String?
  coverReference String?
  synopsis String?
  externalIdentifiers String?
  seriesId String?
  universeId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  libraryEntries LibraryEntry[]
  series Series? @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  universe Universe? @relation(fields: [universeId], references: [id], onDelete: Restrict)
  persons ContentPerson[]
  genres ContentGenre[]
  @@index([mediaType])
  @@index([seriesId])
  @@index([universeId])
  @@map("contents")
}

model LibraryEntry {
  id String @id @default(uuid())
  userId String
  contentId String
  ratingTenths Int?
  appreciationLevel String @default("LIKED")
  status String?
  archiveLocation String
  favorite Boolean @default(false)
  personalNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  content Content @relation(fields: [contentId], references: [id], onDelete: Restrict)
  consumptionEvents ConsumptionEvent[]
  collections CollectionEntry[]
  tags EntryTag[]
  @@unique([userId, contentId])
  @@index([userId, archiveLocation])
  @@map("library_entries")
}

model Collection {
  id String @id @default(uuid())
  userId String
  name String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries CollectionEntry[]
  @@unique([userId, name])
  @@map("collections")
}

model Tag {
  id String @id @default(uuid())
  userId String
  name String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries EntryTag[]
  @@unique([userId, name])
  @@map("tags")
}

model ConsumptionEvent {
  id String @id @default(uuid())
  libraryEntryId String
  occurredAt DateTime
  createdAt DateTime @default(now())
  libraryEntry LibraryEntry @relation(fields: [libraryEntryId], references: [id], onDelete: Cascade)
  @@index([libraryEntryId, occurredAt])
  @@map("consumption_events")
}

model Person {
  id String @id @default(uuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contents ContentPerson[]
  @@unique([name])
  @@map("persons")
}

model Genre {
  id String @id @default(uuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contents ContentGenre[]
  @@unique([name])
  @@map("genres")
}

model Series {
  id String @id @default(uuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contents Content[]
  @@unique([name])
  @@map("series")
}

model Universe {
  id String @id @default(uuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contents Content[]
  @@unique([name])
  @@map("universes")
}

model ContentPerson {
  contentId String
  personId String
  role String
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  @@id([contentId, personId, role])
  @@index([personId])
  @@map("content_persons")
}

model ContentGenre {
  contentId String
  genreId String
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Restrict)
  @@id([contentId, genreId])
  @@index([genreId])
  @@map("content_genres")
}

model CollectionEntry {
  collectionId String
  libraryEntryId String
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  libraryEntry LibraryEntry @relation(fields: [libraryEntryId], references: [id], onDelete: Cascade)
  @@id([collectionId, libraryEntryId])
  @@index([libraryEntryId])
  @@map("collection_entries")
}

model EntryTag {
  libraryEntryId String
  tagId String
  libraryEntry LibraryEntry @relation(fields: [libraryEntryId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([libraryEntryId, tagId])
  @@index([tagId])
  @@map("entry_tags")
}
